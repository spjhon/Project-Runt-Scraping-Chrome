{
  "manifest_version": 3,
  "name": "Extractor RUNT CDA",
  "version": "1.0",
  "permissions": [
    "sidePanel",
    "offscreen",
    "scripting",
    "tabs",
    "declarativeNetRequest",
    "storage",
  "activeTab"
  ],
  "host_permissions": [
    "https://*.runt.gov.co/*",
    "http://192.168.1.5:8090/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://portalpublico.runt.gov.co/*"],
      "js": ["content.js"],
      "all_frames": true
    },
    {
      "matches": [
        "http://192.168.1.5/et/index.php/oficina/vehiculo/Cvehiculo*",
        "http://192.168.1.5:8090/et/index.php/oficina/vehiculo/Cvehiculo*"
      ],
      "js": ["content_tecmmas.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Abrir Extractor RUNT"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
  
}