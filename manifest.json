{
  "manifest_version": 3,
  "name": "Extractor RUNT CDA",
  "version": "1.0",
  "permissions": [
    "sidePanel",
    "offscreen",
    "scripting",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.runt.gov.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://portalpublico.runt.gov.co/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Abrir Extractor RUNT"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
  
}